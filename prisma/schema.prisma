generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MatchStatus {
  QUEUED
  ACTIVE
  FINISHED
  CANCELLED
}

enum MatchResult {
  PLAYER_ONE
  PLAYER_TWO
  DRAW
}

enum AgentKind {
  USER
  OFFICIAL
}

enum AgentProvider {
  OPENAI
  GOOGLE
}

enum OAuthClientType {
  CONFIDENTIAL
  PUBLIC
}

enum OAuthTokenEndpointAuthMethod {
  NONE
  CLIENT_SECRET_POST
  CLIENT_SECRET_BASIC
}

enum OAuthCodeChallengeMethod {
  S256
}

model Agent {
  id                   String            @id @default(cuid())
  slug                 String            @unique
  name                 String
  kind                 AgentKind         @default(USER)
  provider             AgentProvider?
  modelId              String?
  officialKey          String?           @unique
  ownerName            String
  ownerEmail           String?
  description          String?
  aggregateRating      Float             @default(1200)
  aggregateGamesPlayed Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  oauthClients         OAuthClient[]
  oauthAuthorizationCodes OAuthAuthorizationCode[]
  oauthAccessTokens    OAuthAccessToken[]
  oauthRefreshTokens   OAuthRefreshToken[]
  queueEntries         QueueEntry[]
  ratings              Rating[]
  moves                MatchMove[]
  matchesAsPlayerOne   Match[]           @relation("PlayerOneMatches")
  matchesAsPlayerTwo   Match[]           @relation("PlayerTwoMatches")
  wins                 Match[]           @relation("WinnerMatches")

  @@index([aggregateRating])
  @@index([kind, aggregateRating])
}

model OAuthClient {
  id                      String                        @id @default(cuid())
  clientId                String                        @unique
  clientType              OAuthClientType               @default(CONFIDENTIAL)
  tokenEndpointAuthMethod OAuthTokenEndpointAuthMethod  @default(CLIENT_SECRET_POST)
  clientSecretHash        String?
  clientSecretLabel       String?
  displayName             String?
  scope                   String                        @default("mcp")
  redirectUris            String[]                      @default([])
  grantTypes              String[]                      @default([])
  responseTypes           String[]                      @default([])
  metadataJson            String?
  lastUsedAt              DateTime?
  revokedAt               DateTime?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  agentId                 String?
  agent                   Agent?                        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  authorizationCodes      OAuthAuthorizationCode[]
  accessTokens            OAuthAccessToken[]
  refreshTokens           OAuthRefreshToken[]

  @@index([agentId])
}

model OAuthAuthorizationCode {
  id                 String                    @id @default(cuid())
  codeHash           String                    @unique
  redirectUri        String
  scope              String
  audience           String
  codeChallenge      String
  codeChallengeMethod OAuthCodeChallengeMethod
  expiresAt          DateTime
  usedAt             DateTime?
  revokedAt          DateTime?
  createdAt          DateTime                  @default(now())
  oauthClientId      String
  agentId            String
  oauthClient        OAuthClient               @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)
  agent              Agent                     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, expiresAt])
  @@index([oauthClientId, expiresAt])
}

model OAuthAccessToken {
  id            String      @id @default(cuid())
  tokenHash     String      @unique
  scope         String
  audience      String
  expiresAt     DateTime
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime    @default(now())
  oauthClientId String
  agentId       String
  oauthClient   OAuthClient @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)
  agent         Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, expiresAt])
  @@index([oauthClientId, expiresAt])
}

model OAuthRefreshToken {
  id            String      @id @default(cuid())
  tokenHash     String      @unique
  scope         String
  audience      String
  expiresAt     DateTime
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime    @default(now())
  oauthClientId String
  agentId       String
  oauthClient   OAuthClient @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)
  agent         Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, expiresAt])
  @@index([oauthClientId, expiresAt])
}

model Rating {
  id          String   @id @default(cuid())
  gameKey     String
  rating      Float    @default(1200)
  gamesPlayed Int      @default(0)
  wins        Int      @default(0)
  losses      Int      @default(0)
  draws       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, gameKey])
  @@index([gameKey, rating])
}

model QueueEntry {
  id        String   @id @default(cuid())
  gameKey   String
  createdAt DateTime @default(now())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([gameKey, agentId])
  @@index([gameKey, createdAt])
}

model Match {
  id               String      @id @default(cuid())
  gameKey          String
  status           MatchStatus @default(QUEUED)
  result           MatchResult?
  rated            Boolean     @default(true)
  currentTurnAgentId String?
  stateJson        String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  startedAt        DateTime?
  finishedAt       DateTime?
  playerOneId      String
  playerTwoId      String?
  winnerAgentId    String?
  playerOne        Agent       @relation("PlayerOneMatches", fields: [playerOneId], references: [id], onDelete: Restrict)
  playerTwo        Agent?      @relation("PlayerTwoMatches", fields: [playerTwoId], references: [id], onDelete: Restrict)
  winner           Agent?      @relation("WinnerMatches", fields: [winnerAgentId], references: [id], onDelete: SetNull)
  moves            MatchMove[]

  @@index([gameKey, createdAt])
  @@index([status, currentTurnAgentId])
}

model MatchMove {
  id         String   @id @default(cuid())
  moveIndex  Int
  payloadJson String
  createdAt  DateTime @default(now())
  matchId    String
  agentId    String
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@unique([matchId, moveIndex])
  @@index([agentId, createdAt])
}
